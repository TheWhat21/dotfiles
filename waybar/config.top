{
	"layer": "bottom",
	"spacing": 0,
	"height": 0,
	"position": "top",

	"modules-left": ["custom/power", "hyprland/workspaces"],
	"modules-center": ["hyprland/window"],
	"modules-right": ["group/group-right"],

	"custom/power": {
	    "format" : " ⏻ ",
	        "tooltip": false,
	        "menu": "on-click",
	        "menu-file": "~/.config/waybar/power_menu.xml",
	        "menu-actions": {
	        	"logout": "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()' --vt 2",
	            "shutdown": "hyprshutdown -t 'Shutting down...' --post-cmd 'systemctl poweroff' --vt 2",
	            "reboot": "hyprshutdown -t 'Rebooting...' --post-cmd 'systemctl reboot' --vt 2",
	            "suspend": "systemctl suspend",
	            "hibernate": "systemctl hibernate",
	        },
	},

	"hyprland/workspaces": {
		"ignore-workspaces": ["secret"],
		"format": "{name} {icon}",
		"format-icons": {
			"urgent": "",
			"default": "",
			"active": "",
		},
		"hide-empty": true
	},

	"hyprland/window": {
		"max-length": 75,
		 "rewrite": {
			"(.*) - peaclock": "󰺗",
			"class<pcmanfm>": "󰉓",
			"Yazi: (.*)": "󰉓",
			"(.*) - micro": "μ",
			"(.*) — LibreWolf": "",
		    "(.*) — Mozilla Firefox": "",
		    "(.*) - fish": " ",
		    "kitty": "󰄛"
		},
	},

	"group/group-right": {
		"orientation": "inherit",
		"modules": [/* "network", */ "upower", "wireplumber", "tray", "clock"]
	},

	"upower": {
		"format": " {percentage}",
		"tooltip": false
	},

	"wireplumber": {
		"format": "  {volume}%",
		"format-muted": "󰝟 ",
		"on-click": "hyprpwcenter"
	},

	"tray": {
		"spacing": 10
	},

	"clock": {
		"interval": 60,
		"format": "  {:%H:%M}",
		"max-length": 25,
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"format": {
				"today": "<span color='#88c0d0'><b><u>{}</u></b></span>" /* nord8 */
			}
		}
	}
}
